# Скопируй в .env и задай пароль гостя. Не публикуй заполненный .env.
CHAT_PASSWORD=
# Пустое значение: отдельный пароль будет создан в .data/admin-password.
CHAT_ADMIN_PASSWORD=
# Для панели, которая требует внешний bind: HOST=0.0.0.0
HOST=127.0.0.1
PORT=8000
# 1 только за доверенным HTTPS-прокси на том же сервере.
TRUST_PROXY=0
# Для сайта, доступного только по HTTPS за прокси, установи 1.
CHAT_SECURE_COOKIES=0
# CHAT_DATA_DIR=/app/data
